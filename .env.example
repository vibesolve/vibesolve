# Copy this file to .env.local and fill in provider credentials.
# .env.local is gitignored and must never be committed.

# Required for the default provider (openai):
OPENAI_API_KEY=

# Required only when running with --provider claude or --provider anthropic:
ANTHROPIC_API_KEY=

# Required only when running with --provider gemini:
GEMINI_API_KEY=

# Required only when running with --provider mistral:
MISTRAL_API_KEY=

# Required only when running with --provider cohere:
COHERE_API_KEY=

# Required only when running with --provider deepseek:
DEEPSEEK_API_KEY=

# Optional generic single-key override for providers that accept one API key.
# Provider-native environment variables or credential chains also work.
API_KEY=
