# Copy this file to .env.local and fill in provider credentials.
# .env.local is gitignored and must never be committed.

# Default provider: openai
OPENAI_API_KEY=

# --provider anthropic (alias: claude):
ANTHROPIC_API_KEY=

# --provider google (alias: gemini):
GEMINI_API_KEY=

# --provider mistral:
MISTRAL_API_KEY=

# --provider deepseek:
DEEPSEEK_API_KEY=

# Optional key override for the selected provider.
# Leave blank for openai-codex; it requires a Pi login instead.
VIBESOLVE_API_KEY=

# Use an existing Pi Codex login: vibesolve run --provider openai-codex
